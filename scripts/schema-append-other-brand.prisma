
// Dedicated Other-Brand Equipment Master Model (MST-07 / O1-SCR-MST-07)
// Primary Key: Numeric auto-increment ID (1, 2, 3...)
model OtherBrandEquipment {
  id                Int       @id @default(autoincrement())
  equipmentId       String    @unique // e.g. "EQ-OTH-99104"
  customerId        Int?
  customer          Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName      String?   // Snapshot
  siteId            Int?
  site              Site?     @relation(fields: [siteId], references: [id], onDelete: SetNull)
  siteName          String?   // Snapshot
  equipmentCategory String
  brand             String
  model             String
  serial            String?
  serialUnknown     String    @default("No")
  previousSupplier  String?
  takeoverDate      String?
  takeoverCondition String?
  status            String    @default("Active")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([customerId])
  @@index([siteId])
  @@map("other_brand_equipments")
}

