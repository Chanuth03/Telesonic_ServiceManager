// Prisma Schema for Telesonic Service Manager
// Configured with PostgreSQL datasource reading DATABASE_URL from .env

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Job {
  id              String        @id
  customerName    String
  customerContact String?
  town            String
  window          String
  priority        String        // "Critical" | "High" | "Normal" | "Low"
  role            String
  status          String        // "Assigned" | "Accepted" | "In Progress" | "On Hold" | "Completed" | "Declined"
  category        String
  siteName        String?
  siteAddress     String
  technicianName  String
  scheduledDate   String
  syncStatus      String        @default("synced") // "synced" | "pending"
  syncedAt        DateTime?
  version         Int           @default(1)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  labourLogs      LabourLog[]
  partsUsed       PartUsed[]
  inspections     Inspection[]
  holdRequests    HoldRequest[]

  @@map("jobs")
}

model ServiceRequest {
  id              String        @id
  title           String
  callType        String
  customerName    String
  status          String
  priority        String
  assignedTo      String?
  scheduledDate   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("service_requests")
}

model SyncLog {
  id          String    @id @default(cuid())
  batchId     String
  role        String
  deviceId    String
  itemCount   Int
  status      String    // "SUCCESS" | "PARTIAL" | "FAILED"
  details     String?
  syncedAt    DateTime  @default(now())

  @@map("sync_logs")
}

model LabourLog {
  id                  String   @id @default(cuid())
  jobId               String
  job                 Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  technicianName      String
  date                String
  hours               Float
  rateType            String   // "Regular" | "Overtime" | "Weekend/Holiday"
  activityDescription String
  createdAt           DateTime @default(now())

  @@map("labour_logs")
}

model PartUsed {
  id             String   @id @default(cuid())
  jobId          String
  job            Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  partCode       String
  name           String
  qtyUsed        Int
  unitPrice      Float
  createdAt      DateTime @default(now())

  @@map("parts_used")
}

model Inspection {
  id             String   @id @default(cuid())
  jobId          String
  job            Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  inspectedAt    DateTime @default(now())
  technicianName String
  overallStatus  String   // "Pass" | "Fail" | "Conditional Pass"
  generalNotes   String?

  @@map("inspections")
}

model HoldRequest {
  id                  String   @id @default(cuid())
  jobId               String
  job                 Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reason              String
  notes               String
  estimatedDelayHours Float
  requestedAt         DateTime @default(now())
  status              String   // "Submitted" | "Approved" | "Pending Review"

  @@map("hold_requests")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String   // Bcrypt hashed password
  role      String   // "ADMIN" | "TECHNICIAN"
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// ----------------------------------------------------
// Incentive & Commission Management Models
// ----------------------------------------------------

model IncentiveScheme {
  id                 String              @id @default(cuid())
  schemeCode         String              @unique @map("scheme_code")
  schemeName         String              @map("scheme_name")
  division           String
  schemeType         String              @map("scheme_type")
  participantRole    String              @map("participant_role")
  calculationBasis   String              @map("calculation_basis")
  ageBasis           String              @map("age_basis")
  payableLagMonths   Int                 @default(1) @map("payable_lag_months")
  effectiveFrom      DateTime            @map("effective_from")
  effectiveTo        DateTime            @map("effective_to")
  status             String              @default("Draft") // "Draft" | "Approved" | "Active" | "Superseded" | "Inactive"
  version            String              @default("v1.0")
  description        String?
  exclusions         Json?
  posting            Json?
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  rules              SchemeRule[]
  slabs              SchemeSlab[]
  rateItems          SchemeRateItem[]
  versions           SchemeVersion[]
  history            SchemeHistoryLog[]

  @@map("incentive_schemes")
}

model SchemeRule {
  id         String          @id @default(cuid())
  schemeId   String          @map("scheme_id")
  scheme     IncentiveScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  rule       String
  parameter  String
  value      String
  source     String
  createdAt  DateTime        @default(now()) @map("created_at")

  @@map("scheme_rules")
}

model SchemeSlab {
  id            String          @id @default(cuid())
  schemeId      String          @map("scheme_id")
  scheme        IncentiveScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  slabId        String          @map("slab_id")
  minPercent    Float           @map("min_percent")
  maxPercent    Float           @map("max_percent")
  payoutPercent Float           @map("payout_percent")
  multiplier    Float
  description   String?
  createdAt     DateTime        @default(now()) @map("created_at")

  @@map("scheme_slabs")
}

model SchemeRateItem {
  id              String          @id @default(cuid())
  schemeId        String          @map("scheme_id")
  scheme          IncentiveScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  category        String
  productLine     String          @map("product_line")
  commissionRate  String          @map("commission_rate")
  paymentTermBand String          @map("payment_term_band")
  basis           String
  createdAt       DateTime        @default(now()) @map("created_at")

  @@map("scheme_rate_items")
}

model SchemeVersion {
  id             String          @id @default(cuid())
  schemeId       String          @map("scheme_id")
  scheme         IncentiveScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  version        String
  effectiveFrom  DateTime        @map("effective_from")
  effectiveTo    DateTime        @map("effective_to")
  status         String
  createdBy      String          @map("created_by")
  createdDate    DateTime        @default(now()) @map("created_date")
  approvedBy     String?         @map("approved_by")
  approvalDate   DateTime?       @map("approval_date")
  changeSummary  String          @map("change_summary")

  @@map("scheme_versions")
}

model SchemeHistoryLog {
  id         String          @id @default(cuid())
  schemeId   String          @map("scheme_id")
  scheme     IncentiveScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  timestamp  DateTime        @default(now())
  user       String
  role       String
  action     String
  details    String

  @@map("scheme_history_logs")
}

model CommissionRateMatrix {
  id              String             @id
  schemeCode      String             @map("scheme_code")
  matrixName      String             @map("matrix_name")
  version         String             @default("v1.0")
  rowDimension    String             @default("Capacity Band + Item Type") @map("row_dimension")
  columnDimension String             @default("Payment-term / Credit-age Bands") @map("column_dimension")
  rateUnit        String             @default("% of Net Invoiced Value") @map("rate_unit")
  currency        String             @default("USD ($)")
  status          String             @default("Draft")
  description     String?
  createdBy       String             @default("Incentive Administrator") @map("created_by")
  approvedBy      String?            @map("approved_by")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @default(now()) @updatedAt @map("updated_at")

  creditBands     MatrixCreditBand[]
  cells           MatrixCell[]
  historyLogs     MatrixHistoryLog[]

  @@map("commission_rate_matrices")
}

model MatrixCreditBand {
  id            String               @id
  matrixId      String               @map("matrix_id")
  matrix        CommissionRateMatrix @relation(fields: [matrixId], references: [id], onDelete: Cascade)
  name          String
  columnKey     String               @map("column_key")
  minDays       Int                  @map("min_days")
  maxDays       Int                  @map("max_days")
  description   String?
  defaultFactor Float?               @default(1.0) @map("default_factor")
  sortOrder     Int?                 @default(0) @map("sort_order")
  createdAt     DateTime             @default(now()) @map("created_at")

  @@map("matrix_credit_bands")
}

model MatrixCell {
  id            String               @id
  matrixId      String               @map("matrix_id")
  matrix        CommissionRateMatrix @relation(fields: [matrixId], references: [id], onDelete: Cascade)
  capacityBand  String               @map("capacity_band")
  itemType      String               @map("item_type")
  cashImmediate Float?               @map("cash_immediate")
  creditLt15    Float?               @map("credit_lt15")
  creditLt30    Float?               @map("credit_lt30")
  creditLte45   Float?               @map("credit_lte45")
  creditGt45    Float?               @map("credit_gt45")
  sortOrder     Int?                 @default(0) @map("sort_order")
  createdAt     DateTime             @default(now()) @map("created_at")

  @@map("matrix_cells")
}

model MatrixHistoryLog {
  id            String               @id
  matrixId      String               @map("matrix_id")
  matrix        CommissionRateMatrix @relation(fields: [matrixId], references: [id], onDelete: Cascade)
  version       String
  status        String
  timestamp     DateTime             @default(now())
  author        String
  role          String
  changeSummary String               @map("change_summary")
  details       String?

  @@map("matrix_history_logs")
}

model TargetIncentiveSlabTable {
  id          String                 @id
  schemeCode  String                 @map("scheme_code")
  tableName   String                 @map("table_name")
  targetType  String                 @default("Turnover Target") @map("target_type")
  slabMethod  String                 @default("Highest Slab Reached (Non-Cumulative)") @map("slab_method")
  version     String                 @default("v1.0")
  status      String                 @default("Approved")
  description String?
  createdBy   String                 @default("Incentive Administrator") @map("created_by")
  approvedBy  String?                @map("approved_by")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @default(now()) @updatedAt @map("updated_at")

  tiers       SlabTier[]
  historyLogs SlabTableHistoryLog[]

  @@map("target_incentive_slab_tables")
}

model SlabTier {
  id                    String                   @id
  tableId               String                   @map("table_id")
  table                 TargetIncentiveSlabTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  slabTierName          String                   @map("slab_tier_name")
  minAchievementPercent Float                    @default(0.0) @map("min_achievement_percent")
  volumeIncentiveLkr    Float                    @default(0.0) @map("volume_incentive_lkr")
  turnoverIncentiveLkr  Float                    @default(0.0) @map("turnover_incentive_lkr")
  notes                 String?
  sortOrder             Int?                     @default(0) @map("sort_order")
  createdAt             DateTime                 @default(now()) @map("created_at")

  @@map("slab_tiers")
}

model SlabTableHistoryLog {
  id            String                   @id
  tableId       String                   @map("table_id")
  table         TargetIncentiveSlabTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  version       String
  status        String
  timestamp     DateTime                 @default(now())
  author        String
  role          String
  changeSummary String                   @map("change_summary")
  details       String?

  @@map("slab_table_history_logs")
}

model MonthlyTargetBatch {
  id          String                    @id
  period      String
  schemeCode  String                    @map("scheme_code")
  division    String                    @default("All Divisions")
  targetType  String                    @default("Turnover Target (LKR)") @map("target_type")
  version     String                    @default("v1.0 Draft")
  currency    String                    @default("LKR")
  status      String                    @default("Draft")
  isLocked    Boolean                   @default(false) @map("is_locked")
  description String?
  createdBy   String                    @default("Incentive Administrator") @map("created_by")
  approvedBy  String?                   @map("approved_by")
  createdAt   DateTime                  @default(now()) @map("created_at")
  updatedAt   DateTime                  @default(now()) @updatedAt @map("updated_at")

  entries     MonthlyTargetEntry[]
  historyLogs MonthlyTargetHistoryLog[]

  @@map("monthly_target_batches")
}

model MonthlyTargetEntry {
  id               String             @id
  batchId          String             @map("batch_id")
  batch            MonthlyTargetBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  participantId    String             @map("participant_id")
  employeeName     String             @map("employee_name")
  role             String
  division         String
  territory        String
  schemeCode       String             @map("scheme_code")
  baseTargetLkr    Float              @default(0.0) @map("base_target_lkr")
  stretchTargetLkr Float              @default(0.0) @map("stretch_target_lkr")
  mtdActualLkr     Float              @default(0.0) @map("mtd_actual_lkr")
  notes            String?
  sortOrder        Int?               @default(0) @map("sort_order")
  lastUpdated      String?            @map("last_updated")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at")

  @@map("monthly_target_entries")
}

model MonthlyTargetHistoryLog {
  id            String             @id
  batchId       String             @map("batch_id")
  batch         MonthlyTargetBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  version       String
  status        String
  timestamp     DateTime           @default(now())
  author        String
  role          String
  changeSummary String             @map("change_summary")
  details       String?

  @@map("monthly_target_history_logs")
}

model IncentiveParticipant {
  id                String                        @id
  name              String
  salesEmployeeCode String?                       @map("sales_employee_code")
  division          String
  segmentChannel    String?                       @map("segment_channel")
  areaManager       String?                       @map("area_manager")
  designation       String
  payrollId         String                        @map("payroll_id")
  active            Boolean                       @default(true)
  phone             String?
  email             String?
  joinDate          String?                       @map("join_date")
  createdAt         DateTime                      @default(now()) @map("created_at")
  updatedAt         DateTime                      @default(now()) @updatedAt @map("updated_at")

  assignments       ParticipantSchemeAssignment[]
  historyLogs       ParticipantHistoryLog[]

  @@map("incentive_participants")
}

model ParticipantSchemeAssignment {
  id                      String               @id
  participantId           String               @map("participant_id")
  participant             IncentiveParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  schemeCode              String               @map("scheme_code")
  schemeName              String?              @map("scheme_name")
  calculationRole         String               @map("calculation_role")
  isPrimaryRole           Boolean              @default(true) @map("is_primary_role")
  effectiveFrom           DateTime             @map("effective_from")
  effectiveTo             DateTime?            @map("effective_to")
  targetAllocationPercent Float                @default(100.0) @map("target_allocation_percent")
  status                  String               @default("Active")
  notes                   String?
  createdAt               DateTime             @default(now()) @map("created_at")
  updatedAt               DateTime             @default(now()) @updatedAt @map("updated_at")

  @@map("participant_scheme_assignments")
}

model ParticipantHistoryLog {
  id            String               @id
  participantId String               @map("participant_id")
  participant   IncentiveParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  timestamp     DateTime             @default(now())
  author        String
  role          String
  eventType     String               @map("event_type")
  schemeCode    String?              @map("scheme_code")
  previousValue String?              @map("previous_value")
  newValue      String?              @map("new_value")
  changeReason  String?              @map("change_reason")

  @@map("participant_history_logs")
}

model AttendanceImportBatch {
  id          String                    @id
  period      String
  division    String                    @default("Consumer Electronics")
  source      String                    @default("Biometric Punch Terminal (ZKTeco BioTime)")
  status      String                    @default("Draft")
  importedBy  String                    @default("Service Coordinator") @map("imported_by")
  approvedBy  String?                   @map("approved_by")
  approvedAt  DateTime?                 @map("approved_at")
  notes       String?
  createdAt   DateTime                  @default(now()) @map("created_at")
  updatedAt   DateTime                  @default(now()) @updatedAt @map("updated_at")

  records     AttendanceRecord[]
  historyLogs AttendanceBatchHistoryLog[]

  @@map("attendance_import_batches")
}

model AttendanceRecord {
  id               String                @id
  batchId          String                @map("batch_id")
  batch            AttendanceImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  employeeCode     String                @map("employee_code")
  employeeName     String                @map("employee_name")
  role             String
  division         String
  workingDays      Int                   @default(22) @map("working_days")
  leaveDays        Int                   @default(0) @map("leave_days")
  absentDays       Int                   @default(0) @map("absent_days")
  attendanceFactor Float                 @default(1.0) @map("attendance_factor")
  validationStatus String                @default("Valid") @map("validation_status")
  errorMessages    Json?                 @map("error_messages")
  notes            String?
  sortOrder        Int?                  @default(0) @map("sort_order")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @default(now()) @updatedAt @map("updated_at")

  @@map("attendance_records")
}

model AttendanceBatchHistoryLog {
  id        String                @id
  batchId   String                @map("batch_id")
  batch     AttendanceImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  action    String
  userName  String                @map("user_name")
  userRole  String                @map("user_role")
  details   String?
  timestamp DateTime              @default(now())

  @@map("attendance_batch_history_logs")
}

model ServicePerformanceBatch {
  id           String                             @id
  period       String
  division     String                             @default("Consumer Electronics")
  sourceSystem String                             @default("Servio Service Desk / SAP B1 Service Module") @map("source_system")
  receivedOn   String                             @map("received_on")
  status       String                             @default("Draft")
  lockedBy     String?                            @map("locked_by")
  lockedAt     DateTime?                          @map("locked_at")
  notes        String?
  createdAt    DateTime                           @default(now()) @map("created_at")
  updatedAt    DateTime                           @default(now()) @updatedAt @map("updated_at")

  techLines    ServicePerformanceTechnicianLine[]
  jobTickets   ServicePerformanceJobTicket[]
  auditLogs    ServicePerformanceAuditLog[]

  @@map("service_performance_batches")
}

model ServicePerformanceTechnicianLine {
  id            String                  @id
  batchId       String                  @map("batch_id")
  batch         ServicePerformanceBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  employeeCode  String                  @map("employee_code")
  employeeName  String                  @map("employee_name")
  role          String
  division      String
  closedJobs    Int                     @default(0) @map("closed_jobs")
  hodEligible   Int                     @default(0) @map("hod_eligible")
  partial       Int                     @default(0)
  notEligible   Int                     @default(0) @map("not_eligible")
  excluded      Int                     @default(0)
  avgQuality    Float                   @default(0.0) @map("avg_quality")
  avgDiscipline Float                   @default(0.0) @map("avg_discipline")
  poorRepeats   Int                     @default(0) @map("poor_repeats")
  reviewStatus  String                  @default("Reviewed") @map("review_status")
  notes         String?
  sortOrder     Int?                    @default(0) @map("sort_order")
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @default(now()) @updatedAt @map("updated_at")

  @@map("service_performance_technician_lines")
}

model ServicePerformanceJobTicket {
  id                 String                  @id
  batchId            String                  @map("batch_id")
  batch              ServicePerformanceBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  jobTicketNo        String                  @map("job_ticket_no")
  employeeCode       String                  @map("employee_code")
  employeeName       String                  @map("employee_name")
  customerName       String                  @map("customer_name")
  equipmentModel     String                  @map("equipment_model")
  completionDate     String                  @map("completion_date")
  faultCategory      String                  @map("fault_category")
  firstTimeFix       Boolean                 @default(true) @map("first_time_fix")
  qualityScore       Float                   @default(10.0) @map("quality_score")
  disciplineScore    Float                   @default(10.0) @map("discipline_score")
  eligibility        String                  @default("HOD Eligible")
  isPoorRepeat       Boolean                 @default(false) @map("is_poor_repeat")
  repeatReferenceJob String?                 @map("repeat_reference_job")
  hodReviewed        Boolean                 @default(true) @map("hod_reviewed")
  closureStatus      String                  @default("Closed") @map("closure_status")
  notes              String?
  sortOrder          Int?                    @default(0) @map("sort_order")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @default(now()) @updatedAt @map("updated_at")

  @@map("service_performance_job_tickets")
}

model ServicePerformanceAuditLog {
  id        String                  @id
  batchId   String                  @map("batch_id")
  batch     ServicePerformanceBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  timestamp String
  userName  String                  @map("user_name")
  userRole  String                  @map("user_role")
  action    String
  details   String?
  createdAt DateTime                @default(now()) @map("created_at")

  @@map("service_performance_audit_logs")
}

model CalculationResultBatch {
  id                  String                         @id
  period              String
  runDate             String                         @map("run_date")
  status              String                         @default("Calculated")
  runType             String                         @default("MTD Simulation") @map("run_type")
  totalParticipants   Int                            @default(0) @map("total_participants")
  grossCommissionLkr  Float                          @default(0.0) @map("gross_commission_lkr")
  targetIncentiveLkr  Float                          @default(0.0) @map("target_incentive_lkr")
  penaltyClawbackLkr  Float                          @default(0.0) @map("penalty_clawback_lkr")
  netPayableLkr       Float                          @default(0.0) @map("net_payable_lkr")
  notes               String?
  createdAt           DateTime                       @default(now()) @map("created_at")
  updatedAt           DateTime                       @default(now()) @updatedAt @map("updated_at")

  participantResults  CalculationParticipantResult[]
  auditLogs           CalculationResultAuditLog[]

  @@map("calculation_result_batches")
}

model CalculationParticipantResult {
  id                  String                 @id
  batchId             String                 @map("batch_id")
  batch               CalculationResultBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  technicianCode      String                 @map("technician_code")
  technicianName      String                 @map("technician_name")
  role                String
  division            String
  schemeCode          String                 @map("scheme_code")
  schemeName          String                 @map("scheme_name")
  targetVolume        Float                  @default(0.0) @map("target_volume")
  actualVolume        Float                  @default(0.0) @map("actual_volume")
  volumePct           Float                  @default(0.0) @map("volume_pct")
  targetTurnover      Float                  @default(0.0) @map("target_turnover")
  actualTurnover      Float                  @default(0.0) @map("actual_turnover")
  turnoverPct         Float                  @default(0.0) @map("turnover_pct")
  slabTier            String                 @default("Tier 1") @map("slab_tier")
  slabMultiplier      Float                  @default(1.0) @map("slab_multiplier")
  grossCommission     Float                  @default(0.0) @map("gross_commission")
  targetIncentive     Float                  @default(0.0) @map("target_incentive")
  attendanceFactor    Float                  @default(1.0) @map("attendance_factor")
  penaltyClawback     Float                  @default(0.0) @map("penalty_clawback")
  netPayable          Float                  @default(0.0) @map("net_payable")
  status              String                 @default("Calculated")
  jobCount            Int                    @default(0) @map("job_count")
  overdueInvoiceCount Int                    @default(0) @map("overdue_invoice_count")
  notes               String?
  sortOrder           Int?                   @default(0) @map("sort_order")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @default(now()) @updatedAt @map("updated_at")

  @@map("calculation_participant_results")
}

model CalculationResultAuditLog {
  id        String                 @id
  batchId   String                 @map("batch_id")
  batch     CalculationResultBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  timestamp String
  userName  String                 @map("user_name")
  userRole  String                 @map("user_role")
  action    String
  details   String?
  createdAt DateTime               @default(now()) @map("created_at")

  @@map("calculation_result_audit_logs")
}

// -----------------------------------------------------------------------------
// 28. INCENTIVE CALCULATION RUN ENGINE (INC-SCR-09)
// -----------------------------------------------------------------------------

model IncentiveCalculationRun {
  id                   String                         @id
  runNo                String                         @map("run_no")
  period               String
  division             String                         @default("All Divisions")
  selectedSchemes      String                         @default("All Active Schemes (4 Schemes)") @map("selected_schemes")
  runType              String                         @default("Simulation") @map("run_type")
  dataCutoff           String                         @map("data_cutoff")
  status               String                         @default("Simulated")
  runBy                String                         @map("run_by")
  startedAt            String?                        @map("started_at")
  finishedAt           String?                        @map("finished_at")
  totalParticipants    Int                            @default(0) @map("total_participants")
  totalDocsRead        Int                            @default(0) @map("total_docs_read")
  totalGrossCommission Float                          @default(0.0) @map("total_gross_commission")
  totalTargetIncentive Float                          @default(0.0) @map("total_target_incentive")
  totalPenalty         Float                          @default(0.0) @map("total_penalty")
  totalNetPayable      Float                          @default(0.0) @map("total_net_payable")
  notes                String?
  createdAt            DateTime                       @default(now()) @map("created_at")
  updatedAt            DateTime                       @default(now()) @updatedAt @map("updated_at")

  readinessChecks      CalculationRunReadinessCheck[]
  schemeSummaries      CalculationRunSchemeSummary[]
  warnings             CalculationRunWarning[]
  logs                 CalculationRunLog[]

  @@map("incentive_calculation_runs")
}

model CalculationRunReadinessCheck {
  id            String                  @id
  runId         String                  @map("run_id")
  run           IncentiveCalculationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  moduleName    String                  @map("module_name")
  requiredState String                  @map("required_state")
  currentState  String                  @map("current_state")
  isReady       Boolean                 @default(true) @map("is_ready")
  signer        String
  lastUpdated   String                  @map("last_updated")
  createdAt     DateTime                @default(now()) @map("created_at")

  @@map("calculation_run_readiness_checks")
}

model CalculationRunSchemeSummary {
  id              String                  @id
  runId           String                  @map("run_id")
  run             IncentiveCalculationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  schemeCode      String                  @map("scheme_code")
  schemeName      String                  @map("scheme_name")
  division        String
  participants    Int                     @default(0)
  documentsRead   Int                     @default(0) @map("documents_read")
  grossCommission Float                   @default(0.0) @map("gross_commission")
  targetIncentive Float                   @default(0.0) @map("target_incentive")
  penalty         Float                   @default(0.0)
  netPayable      Float                   @default(0.0) @map("net_payable")
  warningsCount   Int                     @default(0) @map("warnings_count")
  createdAt       DateTime                @default(now()) @map("created_at")

  @@map("calculation_run_scheme_summaries")
}

model CalculationRunWarning {
  id              String                  @id
  runId           String                  @map("run_id")
  run             IncentiveCalculationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  code            String
  schemeCode      String                  @map("scheme_code")
  participantName String                  @map("participant_name")
  severity        String                  @default("Medium")
  message         String
  remediation     String
  createdAt       DateTime                @default(now()) @map("created_at")

  @@map("calculation_run_warnings")
}

model CalculationRunLog {
  id        String                  @id
  runId     String                  @map("run_id")
  run       IncentiveCalculationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  timestamp String
  level     String                  @default("INFO")
  message   String
  createdAt DateTime                @default(now()) @map("created_at")

  @@map("calculation_run_logs")
}

// ====================================================================
// 36. INCENTIVE MANUAL ADJUSTMENTS & BONUS CLAIMS (INC-SCR-10)
// ====================================================================
model IncentiveManualAdjustment {
  id             String                     @id
  adjustmentNo   String                     @unique @map("adjustment_no")
  runNo          String                     @map("run_no")
  participantId  String                     @map("participant_id")
  participantName String                    @map("participant_name")
  division       String
  schemeCode     String                     @map("scheme_code")
  schemeName     String                     @map("scheme_name")
  adjustmentType String                     @default("Addition") @map("adjustment_type") // "Addition" | "Deduction"
  amount         Float                      @default(0.0)
  reason         String
  remarks        String
  attachment     String?
  status         String                     @default("Draft") // "Draft" | "Submitted" | "Approved" | "Rejected"
  requiresCeo    Boolean                    @default(false) @map("requires_ceo")
  createdBy      String                     @map("created_by")
  createdAt      DateTime                   @default(now()) @map("created_at")
  updatedAt      DateTime                   @default(now()) @updatedAt @map("updated_at")

  approvals      ManualAdjustmentApproval[]
  history        ManualAdjustmentHistory[]

  @@map("incentive_manual_adjustments")
}

model ManualAdjustmentApproval {
  id           String                    @id
  adjustmentId String                    @map("adjustment_id")
  adjustment   IncentiveManualAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  stepNumber   Int                       @map("step_number")
  roleName     String                    @map("role_name")
  approverName String                    @map("approver_name")
  decision     String                    @default("Pending") // "Pending" | "Approved" | "Rejected"
  decidedAt    String?                   @map("decided_at")
  comments     String?
  createdAt    DateTime                  @default(now()) @map("created_at")

  @@map("manual_adjustment_approvals")
}

model ManualAdjustmentHistory {
  id           String                    @id
  adjustmentId String                    @map("adjustment_id")
  adjustment   IncentiveManualAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  action       String
  performedBy  String                    @map("performed_by")
  performedAt  String                    @map("performed_at")
  notes        String?
  createdAt    DateTime                  @default(now()) @map("created_at")

  @@map("manual_adjustment_history")
}

// ====================================================================
// 37. MULTI-LEVEL APPROVAL & POSTING PACKAGES (INC-SCR-11)
// ====================================================================
model IncentiveApprovalBatch {
  id            String                 @id
  runNo         String                 @unique @map("run_no")
  period        String
  division      String
  totalPayable  Float                  @default(0.0) @map("total_payable")
  postingMethod String                 @default("Accrual JE + payroll export") @map("posting_method")
  accrualJe     String?                @map("accrual_je")
  payrollFile   String?                @map("payroll_file")
  status        String                 @default("Submitted") // "Submitted" | "Approved" | "Posted" | "Locked" | "Rejected"
  currentStep   Int                    @default(1) @map("current_step")
  totalSteps    Int                    @default(4) @map("total_steps")
  notes         String?
  submittedBy   String                 @map("submitted_by")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @default(now()) @updatedAt @map("updated_at")

  steps         ApprovalBatchStep[]
  postingLines  ApprovalPostingLine[]
  history       ApprovalBatchHistory[]

  @@map("incentive_approval_batches")
}

model ApprovalBatchStep {
  id           String                 @id
  batchId      String                 @map("batch_id")
  batch        IncentiveApprovalBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  stepNumber   Int                    @map("step_number")
  roleName     String                 @map("role_name")
  approverName String                 @map("approver_name")
  decision     String                 @default("Pending") // "Pending" | "Approved" | "Rejected" | "Skipped"
  decidedAt    String?                @map("decided_at")
  comments     String?
  createdAt    DateTime               @default(now()) @map("created_at")

  @@map("approval_batch_steps")
}

model ApprovalPostingLine {
  id                 String                 @id
  batchId            String                 @map("batch_id")
  batch              IncentiveApprovalBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  lineNo             Int                    @map("line_no")
  divisionCostCentre String                 @map("division_cost_centre")
  glExpenseAccount   String                 @map("gl_expense_account")
  glExpenseName      String                 @map("gl_expense_name")
  glPayableAccount   String                 @map("gl_payable_account")
  glPayableName      String                 @map("gl_payable_name")
  amount             Float                  @default(0.0)
  dimension          String
  createdAt          DateTime               @default(now()) @map("created_at")

  @@map("approval_posting_lines")
}

model ApprovalBatchHistory {
  id          String                 @id
  batchId     String                 @map("batch_id")
  batch       IncentiveApprovalBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  action      String
  performedBy String                 @map("performed_by")
  performedAt String                 @map("performed_at")
  notes       String?
  createdAt   DateTime               @default(now()) @map("created_at")

  @@map("approval_batch_history")
}

// ====================================================================
// 38. GL POSTING & PAYROLL HANDOVER (INC-SCR-12 / GL POSTING)
// ====================================================================
model IncentiveGLPostingBatch {
  id                 String                          @id
  postingRef         String                          @unique @map("posting_ref")
  runNo              String                          @map("run_no")
  period             String
  division           String
  postingDate        String                          @map("posting_date")
  journalEntryNo     String?                         @map("journal_entry_no")
  totalDebit         Float                           @default(0.0) @map("total_debit")
  totalCredit        Float                           @default(0.0) @map("total_credit")
  payrollBatchNo     String?                         @map("payroll_batch_no")
  payrollFileName    String?                         @map("payroll_file_name")
  bankFormat         String                          @default("SLIPS / CEFT") @map("bank_format")
  bankFileName       String?                         @map("bank_file_name")
  status             String                          @default("Draft") // "Draft" | "Ready to Post" | "Posted" | "Handed Over" | "Reconciled"
  paymentLagMonths   Int                             @default(3) @map("payment_lag_months")
  disbursementMonth  String                          @default("July 2026") @map("disbursement_month")
  notes              String?
  postedBy           String?                         @map("posted_by")
  createdBy          String                          @map("created_by")
  createdAt          DateTime                        @default(now()) @map("created_at")
  updatedAt          DateTime                        @default(now()) @updatedAt @map("updated_at")

  lines              IncentiveGLPostingLine[]
  payrollItems       IncentivePayrollHandoverItem[]

  @@map("incentive_gl_posting_batches")
}

model IncentiveGLPostingLine {
  id             String                  @id
  postingBatchId String                  @map("posting_batch_id")
  batch          IncentiveGLPostingBatch @relation(fields: [postingBatchId], references: [id], onDelete: Cascade)
  lineNo         Int                     @map("line_no")
  accountType    String                  @map("account_type") // "Debit" | "Credit"
  glAccountCode  String                  @map("gl_account_code")
  glAccountName  String                  @map("gl_account_name")
  costCentre     String                  @map("cost_centre")
  amount         Float                   @default(0.0)
  memo           String?
  createdAt      DateTime                @default(now()) @map("created_at")

  @@map("incentive_gl_posting_lines")
}

model IncentivePayrollHandoverItem {
  id              String                  @id
  postingBatchId  String                  @map("posting_batch_id")
  batch           IncentiveGLPostingBatch @relation(fields: [postingBatchId], references: [id], onDelete: Cascade)
  employeeId      String                  @map("employee_id")
  employeeName    String                  @map("employee_name")
  designation     String
  division        String
  epfNo           String?                 @map("epf_no")
  bankName        String                  @map("bank_name")
  bankAccountNo   String                  @map("bank_account_no")
  grossAmount     Float                   @default(0.0) @map("gross_amount")
  taxDeduction    Float                   @default(0.0) @map("tax_deduction")
  netDisbursement Float                   @default(0.0) @map("net_disbursement")
  paymentStatus   String                  @default("Pending Handover") @map("payment_status")
  createdAt       DateTime                @default(now()) @map("created_at")

  @@map("incentive_payroll_handover_items")
}

model IncentiveParticipantStatement {
  id                 String                  @id
  statementNo        String                  @unique @map("statement_no")
  participantId      String                  @map("participant_id")
  salesCode          String?                 @map("sales_code")
  participantName    String                  @map("participant_name")
  designation        String
  division           String
  period             String
  runNo              String                  @map("run_no")
  payableCommission  Float                   @default(0.0) @map("payable_commission")
  targetIncentive    Float                   @default(0.0) @map("target_incentive")
  serviceAllowance   Float                   @default(0.0) @map("service_allowance")
  adjustmentsAmount  Float                   @default(0.0) @map("adjustments_amount")
  penaltiesClawback  Float                   @default(0.0) @map("penalties_clawback")
  netPayable         Float                   @default(0.0) @map("net_payable")
  paymentLagMonths   Int                     @default(3) @map("payment_lag_months")
  disbursementMonth  String                  @default("July 2026") @map("disbursement_month")
  bankName           String?                 @map("bank_name")
  bankAccountNo      String?                 @map("bank_account_no")
  status             String                  @default("Calculated") // "Draft" | "Calculated" | "Approved" | "Issued" | "Disbursed"
  issuedAt           String?                 @map("issued_at")
  preparedBy         String                  @map("prepared_by")
  verifiedBy         String?                 @map("verified_by")
  approvedBy         String?                 @map("approved_by")
  notes              String?
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @default(now()) @updatedAt @map("updated_at")

  lines              IncentiveStatementLine[]

  @@map("incentive_participant_statements")
}

model IncentiveStatementLine {
  id               String                         @id
  statementId      String                         @map("statement_id")
  statement        IncentiveParticipantStatement  @relation(fields: [statementId], references: [id], onDelete: Cascade)
  lineNo           Int                            @map("line_no")
  componentType    String                         @map("component_type")
  description      String
  targetValue      Float?                         @map("target_value")
  achievementValue Float?                         @map("achievement_value")
  achievementPct   Float?                         @map("achievement_pct")
  earnedAmount     Float                          @default(0.0) @map("earned_amount")
  remarks          String?
  createdAt        DateTime                       @default(now()) @map("created_at")

  @@map("incentive_statement_lines")
}

model IncentiveDispute {
  id                 String    @id
  disputeNo          String    @unique @map("dispute_no")
  participantId      String    @map("participant_id")
  salesCode          String?   @map("sales_code")
  participantName    String    @map("participant_name")
  designation        String
  division           String
  period             String
  statementRef       String?   @map("statement_ref")
  category           String
  priority           String    @default("Medium") // "Critical" | "High" | "Medium" | "Low"
  claimedAmount      Float     @default(0.0) @map("claimed_amount")
  approvedAmount     Float     @default(0.0) @map("approved_amount")
  status             String    @default("New") // "New" | "Under Investigation" | "Approved" | "Resolved" | "Rejected"
  description        String
  investigationNotes String?   @map("investigation_notes")
  resolutionAction   String?   @map("resolution_action")
  assignedTo         String?   @map("assigned_to")
  resolvedBy         String?   @map("resolved_by")
  resolvedAt         String?   @map("resolved_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("incentive_disputes")
}

model IncentiveDivisionBudget {
  id                  String    @id
  period              String
  division            String
  targetSales         Float     @default(0.0) @map("target_sales")
  actualSales         Float     @default(0.0) @map("actual_sales")
  targetCollections   Float     @default(0.0) @map("target_collections")
  actualCollections   Float     @default(0.0) @map("actual_collections")
  budgetAllocation    Float     @default(0.0) @map("budget_allocation")
  actualIncentiveCost Float     @default(0.0) @map("actual_incentive_cost")
  costRatioPct        Float     @default(0.0) @map("cost_ratio_pct")
  varianceAmount      Float     @default(0.0) @map("variance_amount")
  participantCount    Int       @default(0) @map("participant_count")
  status              String    @default("On Track") // "On Track" | "Under Budget" | "Budget Exceeded"
  notes               String?
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("incentive_division_budgets")
}

model IncentiveDashboardRecord {
  id                  String    @id
  participantCode     String    @map("participant_code")
  displayName         String    @map("display_name")
  role                String
  division            String
  period              String
  volumePct           Float     @default(0.0) @map("volume_pct")
  turnoverPct         Float     @default(0.0) @map("turnover_pct")
  projectedCommission Float     @default(0.0) @map("projected_commission")
  invoicesOver45Days  Int       @default(0) @map("invoices_over_45_days")
  penaltyExposure     Float     @default(0.0) @map("penalty_exposure")
  baseTarget          Float     @default(0.0) @map("base_target")
  actualAchievement   Float     @default(0.0) @map("actual_achievement")
  attendanceFactor    Float     @default(1.0) @map("attendance_factor")
  status              String    @default("Active")
  notes               String?
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("incentive_dashboard_records")
}

model IncentiveClawbackPenalty {
  id                 String    @id
  participantCode    String    @map("participant_code")
  participantName    String    @map("participant_name")
  division           String
  period             String
  recordType         String    @map("record_type")
  tabCategory        String    @default("Penalty") @map("tab_category")
  invoiceNo          String    @map("invoice_no")
  customerName       String    @map("customer_name")
  netValue           Decimal   @default(0.0) @db.Decimal(14, 2) @map("net_value")
  dueAgeDays         Int       @default(0) @map("due_age_days")
  bracket            String
  ratePercent        Decimal   @default(0.0) @db.Decimal(6, 2) @map("rate_percent")
  penaltyAmount      Decimal   @default(0.0) @db.Decimal(14, 2) @map("penalty_amount")
  runNo              String    @map("run_no")
  isRecurring        Boolean   @default(true) @map("is_recurring")
  settlementStatus   String    @default("Pending") @map("settlement_status")
  settledAt          DateTime? @map("settled_at")
  settledBy          String?   @map("settled_by")
  resolutionRemarks  String?   @map("resolution_remarks")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([participantCode], map: "idx_clawback_part")
  @@index([period], map: "idx_clawback_period")
  @@index([recordType], map: "idx_clawback_type")
  @@index([settlementStatus], map: "idx_clawback_status")
  @@map("incentive_clawback_penalties")
}

model IncentiveAuditLog {
  id                 String    @id
  timestamp          DateTime  @default(now())
  entityType         String    @map("entity_type")
  entityId           String    @map("entity_id")
  actionType         String    @map("action_type")
  performedBy        String    @map("performed_by")
  role               String
  terminalIp         String    @default("172.16.0.201") @map("terminal_ip")
  severity           String    @default("INFO")
  oldValue           String?   @map("old_value")
  newValue           String?   @map("new_value")
  diffSummary        String    @map("diff_summary")
  versionTag         String?   @map("version_tag")
  verificationStatus String    @default("Verified") @map("verification_status")
  auditorNotes       String?   @map("auditor_notes")
  hashChecksum       String    @map("hash_checksum")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([entityType, entityId], map: "idx_audit_entity")
  @@index([actionType], map: "idx_audit_action")
  @@index([timestamp], map: "idx_audit_time")
  @@index([verificationStatus], map: "idx_audit_status")
  @@map("incentive_audit_logs")
}

model IncentiveSystemParameter {
  id             String    @id
  parameterKey   String    @unique @map("parameter_key")
  parameterName  String    @map("parameter_name")
  category       String
  parameterValue String    @map("parameter_value")
  unit           String    @default("Days")
  defaultValue   String    @map("default_value")
  description    String
  isEditable     Boolean   @default(true) @map("is_editable")
  effectiveFrom  String    @default("2026-01-01") @map("effective_from")
  lastUpdatedBy  String    @default("System Administrator") @map("last_updated_by")
  lastUpdatedAt  DateTime? @default(now()) @map("last_updated_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([category], map: "idx_param_category")
  @@index([parameterKey], map: "idx_param_key")
  @@map("incentive_system_parameters")
}

model IncentiveDivision {
  id             String    @id
  divisionCode   String    @unique @map("division_code")
  divisionName   String    @map("division_name")
  description    String
  hodName        String    @map("hod_name")
  hodEmail       String?   @map("hod_email")
  costCenterCode String    @map("cost_center_code")
  status         String    @default("Active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([divisionCode], map: "idx_div_code")
  @@index([status], map: "idx_div_status")
  @@map("incentive_divisions")
}



