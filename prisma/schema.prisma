  accountType    String                  @map("account_type") // "Debit" | "Credit"
  glAccountCode  String                  @map("gl_account_code")
  glAccountName  String                  @map("gl_account_name")
  costCentre     String                  @map("cost_centre")
  amount         Float                   @default(0.0)
  memo           String?
  createdAt      DateTime                @default(now()) @map("created_at")

  @@map("incentive_gl_posting_lines")
}

model IncentivePayrollHandoverItem {
  id              String                  @id
  postingBatchId  String                  @map("posting_batch_id")
